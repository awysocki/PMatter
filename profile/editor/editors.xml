<editors>
  <editor id="bool">
    <range uom="2" subset="0-1" nls="BOOL" />
  </editor>
  <editor id="pct">
    <range uom="51" subset="0-100" />
  </editor>
  <editor id="onOff">
    <range uom="25" subset="0-1" nls="ONOFF" />
  </editor>
  <editor id="watt">
    <range uom="73" min="0" max="100000" prec="2" />
  </editor>
  <editor id="kwh">
    <range uom="33" min="0" max="1000000" prec="3" />
  </editor>
  <editor id="volt">
    <range uom="72" min="0" max="1000" prec="1" />
  </editor>
  <editor id="amp">
    <range uom="1" min="0" max="100" prec="2" />
  </editor>
</editors>

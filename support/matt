#!/usr/bin/env bash

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_ENGINE="${SCRIPT_DIR}/matter_cli.py"
RAW_ENGINE="${SCRIPT_DIR}/raw.py"

show_help() {
    echo "Matter CLI Tool Usage:"
    echo "  matt add <code/QR> [node_id] - Pair device (e.g., matt add 34970112332 or matt add 34970112332 15)"
    echo "  matt del <node_id>          - Unpair/remove a device (e.g., matt del 1)"
    echo "  matt list                   - List all paired Matter devices and states"
    echo "  matt status <node_id>       - Detailed metadata and state for a node"
    echo "  matt features <node_id>     - List clusters/attributes (feature list) for a node"
    echo "  matt on <node_id>           - Turn a switch ON"
    echo "  matt off <node_id>          - Turn a switch OFF"
    echo "  matt monitor [uri] [node_id] - Print raw Matter server WebSocket message stream, optionally filtered to one node"
    echo "  matt --server ws://host:5580/ws add <code/QR> [node_id]"
}

if [ "${1:-}" = "--server" ]; then
    if [ -z "${2:-}" ] || [ -z "${3:-}" ]; then
        echo "[FAIL] Usage: matt --server ws://host:5580/ws <command> [args...]"
        exit 1
    fi
    export MATTER_SERVER_URI="$2"
    shift 2
fi

if [ $# -lt 1 ]; then
    show_help
    exit 1
fi

case "$1" in
    add|commission|del|delete|remove|list|ls|status|info|features|feature|caps|capabilities|on|off)
        python3 "${PYTHON_ENGINE}" "$@"
        ;;
    monitor|listen|events|raw)
        shift
        python3 "${RAW_ENGINE}" "$@"
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        echo "[FAIL] Unknown command: $1"
        echo ""
        show_help
        exit 1
        ;;
esac